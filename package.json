{
  "name": "gmail-gdocs-mcp",
  "version": "1.0.0",
  "description": "Client-agnostic MCP server to send Gmail email and append to Google Docs.",
  "type": "module",
  "bin": {
    "gmail-gdocs-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "examples",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http",
    "auth": "node dist/index.js auth",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run test/integration",
    "inspector": "npx -y @modelcontextprotocol/inspector node dist/index.js",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "google-auth-library": "11.3.1",
    "googleapis": "187.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "google-docs",
    "mcp-server"
  ]
}
