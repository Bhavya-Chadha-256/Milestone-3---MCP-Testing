# Copy to .env for local development. Never commit the real file.

# --- Google OAuth (default mode). Create an OAuth client of type "Desktop app". ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# GOOGLE_TOKEN_PATH=~/.config/gmail-gdocs-mcp/token.json

# --- Service-account mode (Google Workspace only; overrides OAuth when set) ---
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account.json
# GOOGLE_IMPERSONATE_USER=sender@yourcompany.com

# --- Transport ---
# MCP_TRANSPORT=stdio            # or http
# HOST=127.0.0.1
# PORT=3000
# MCP_AUTH_TOKEN=                # required for http; e.g. `openssl rand -hex 32`
# MCP_ALLOW_UNAUTHENTICATED=false # only honoured with HOST=127.0.0.1
# MCP_ALLOWED_ORIGINS=           # extra browser origins, comma-separated
# MCP_ALLOWED_HOSTS=             # restrict accepted Host headers, comma-separated

# --- Safety policy ---
# ALLOWED_RECIPIENT_DOMAINS=mycompany.com,*.mycompany.com
# ALLOWED_DOCUMENT_IDS=
# MAX_RECIPIENTS=50
# MAX_ATTACHMENT_BYTES=10485760
# RATE_LIMIT_EMAILS_PER_HOUR=30
# RATE_LIMIT_DOC_APPENDS_PER_MINUTE=30
# REQUIRE_DRY_RUN_FIRST=false

# --- Misc ---
# TIMEZONE=UTC
# LOG_LEVEL=info

# --- Integration tests only (npm run test:integration) ---
# TEST_EMAIL_TO=you@example.com
# TEST_DOC_ID=
# TEST_READONLY_DOC_ID=
